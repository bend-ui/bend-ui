{
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "targetDefaults": {
    "build-storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.storybook/**/*",
        "{projectRoot}/.storybook/**/*",
        "{projectRoot}/tsconfig.storybook.json"
      ],
      "cache": true
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^default"]
    },
    "build": [
      {
        "cache": true,
        "dependsOn": ["^build"]
      },
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "production",
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production"
          }
        },
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      {
        "filter": {
          "plugin": "@nx/next/plugin"
        },
        "configurations": {
          "development": {}
        },
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    ],
    "preview": [
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "development",
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production"
          }
        }
      }
    ],
    "serve": [
      {
        "filter": {
          "plugin": "@nx/vite/plugin"
        },
        "defaultConfiguration": "development",
        "configurations": {
          "development": {
            "mode": "development"
          },
          "production": {
            "mode": "production"
          }
        }
      },
      {
        "filter": {
          "plugin": "@nx/next/plugin"
        },
        "defaultConfiguration": "development",
        "configurations": {
          "development": {},
          "production": {}
        }
      }
    ],
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "none",
        "linter": "eslint",
        "bundler": "vite"
      },
      "library": {
        "style": "none",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      },
      "component": {
        "style": "none"
      }
    },
    "@nx/next": {
      "application": {
        "style": "none",
        "linter": "eslint"
      }
    }
  },
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "release": {
    "version": {
      "preVersionCommand": "pnpm dlx nx run-many -t build"
    }
  },
  "plugins": [
    {
      "plugin": "@nx/storybook/plugin",
      "options": {
        "buildStorybookTargetName": "build-storybook",
        "serveStorybookTargetName": "storybook",
        "staticStorybookTargetName": "static-storybook",
        "testStorybookTargetName": "test-storybook"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "test"
      },
      "include": [
        "apps/vite-ark-ui/**/*",
        "apps/vite-base-ui/**/*",
        "apps/vite-base-ui-theming/**/*",
        "packages/ariakit/**/*",
        "packages/ark-ui/**/*",
        "packages/base-ui/**/*",
        "packages/cli/**/*",
        "packages/config/**/*",
        "packages/preset/**/*",
        "packages/react-aria/**/*",
        "packages/react-utils/**/*",
        "apps/website/**/*",
        "apps/playground-panda/**/*"
      ]
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": "e2e-ci"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      },
      "exclude": ["tools/fixtures/**"]
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck",
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      },
      "include": [
        "apps/vite-ark-ui/**/*",
        "apps/vite-base-ui/**/*",
        "apps/vite-base-ui-theming/**/*"
      ]
    },
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "serve",
        "startTargetName": "start",
        "serveStaticTargetName": "serve-static"
      }
    }
  ],
  "analytics": true,
  "affected": {
    "legacy": true
  },
  "nxCloudId": "63aa07c2af483a0c8331e4f0"
}
