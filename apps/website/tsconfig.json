{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "moduleResolution": "Bundler",
    "paths": {
      "fumadocs-mdx:collections/server": [
        ".source/server"
      ],
      "fumadocs-mdx:collections/dynamic": [
        ".source/dynamic"
      ],
      "fumadocs-mdx:collections/browser": [
        ".source/browser"
      ],
      "@particles/base-ui": [
        "packages/base-ui/src/index.ts"
      ],
      "@particles/react": [
        "packages/react/src/index.ts"
      ],
      "@particles/primitives": [
        "packages/primitives/src/index.ts"
      ],
      "@particles/react-utils": [
        "packages/react-utils/src/index.ts"
      ],
      "@particles/preset": [
        "packages/preset/src/index.ts"
      ],
      "@particles/preset-base": [
        "packages/preset-base/src/index.ts"
      ],
      "@particles/styled-system/*": [
        "apps/website/styled-system/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "jest",
      "node"
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "../../dist/apps/website/.next/types/**/*.ts",
    "next.config.mjs",
    "source.config.ts",
    "panda.config.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".source"
  ]
}
