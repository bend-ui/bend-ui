{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "moduleResolution": "Bundler",
    "paths": {
      "fumadocs-mdx:collections/server": [".source/server"],
      "fumadocs-mdx:collections/dynamic": [".source/dynamic"],
      "fumadocs-mdx:collections/browser": [".source/browser"],
      "@bend-ui/base-ui": ["packages/base-ui/src/index.ts"],
      "@bend-ui/preset": ["packages/preset/src/index.ts"],
      "@bend-ui/preset-base": ["packages/preset-base/src/index.ts"],
      "@bend-ui/styled-system/*": ["apps/website/styled-system/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["jest", "node"],
    "strictNullChecks": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "../../dist/apps/website/.next/types/**/*.ts",
    "next.config.mjs",
    "source.config.ts",
    "panda.config.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".source"
  ]
}
