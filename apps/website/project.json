{
  "name": "website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "build": {
      "options": {
        "command": "next build --webpack"
      },
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/website/.next",
        "{projectRoot}/.next"
      ]
    },
    "serve": {
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "command": "pnpm exec nx run website:start"
        }
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/apps/website/export"],
      "options": {
        "cwd": "apps/website",
        "command": "next build --webpack",
        "env": {
          "BEND_NEXT_EXPORT": "true"
        }
      }
    }
  }
}
