{
  "name": "website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/website",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "build": {
      "options": {
        "command": "next build --webpack"
      },
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/website/.next",
        "{projectRoot}/.next"
      ],
      "dependsOn": ["^build", "prepare"]
    },
    "serve": {
      "options": {
        "port": 4200,
        "command": "next dev --webpack"
      },
      "configurations": {
        "production": {
          "command": "pnpm exec nx run website:start"
        }
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/apps/website/export"],
      "options": {
        "cwd": "apps/website",
        "command": "next build --webpack",
        "env": {
          "BEND_NEXT_EXPORT": "true"
        }
      }
    },
    "prepare": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/styled-system", "{projectRoot}/.source"],
      "options": {
        "cwd": "apps/website",
        "commands": ["panda codegen --clean", "fumadocs-mdx"],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": ["^build", "prepare"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/website",
        "commands": [
          "tsc -p tsconfig.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
