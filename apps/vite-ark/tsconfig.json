{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "vite/client",
      "vitest"
    ],
    "paths": {
      "~/*": [
        "apps/vite-ark/src/*"
      ],
      "@particles/ark": [
        "packages/ark/src/index.ts"
      ],
      "@particles/react": [
        "packages/react/src/index.ts"
      ],
      "@particles/react-utils": [
        "packages/react-utils/src/index.ts"
      ],
      "@particles/preset": [
        "packages/preset/src/index.ts"
      ],
      "@particles/preset-base": [
        "packages/preset-base/src/index.ts"
      ],
      "@particles/styled-system/*": [
        "packages/styled-system/*"
      ]
    }
  },
  "files": [],
  "include": [
    "**.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
