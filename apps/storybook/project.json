{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storybook/src",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "storybook": {
      "options": {
        "port": 4400,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": [
        "{workspaceRoot}/dist/storybook/storybook",
        "{projectRoot}/storybook-static",
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/{options.outputDir}",
        "{projectRoot}/{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "storybook:build-storybook",
        "staticFilePath": "dist/storybook/storybook"
      },
      "configurations": {
        "ci": {
          "buildTarget": "storybook:build-storybook:ci"
        }
      }
    }
  }
}
