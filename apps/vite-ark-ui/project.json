{
  "name": "vite-ark-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vite-ark-ui/src",
  "projectType": "application",
  "tags": ["example", "app"],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/apps/vite-ark-ui"
      ],
      "options": {
        "outDir": "../../dist/apps/vite-ark-ui"
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/vite-ark-ui"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/vite-ark-ui"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "vite-ark-ui:build",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      }
    }
  }
}
