{
  "name": "vite-base-ui-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vite-base-ui-e2e/src",
  "tags": [],
  "implicitDependencies": ["vite-base-ui"],
  "targets": {
    "e2e": {
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/vite-base-ui-e2e"]
    },
    "e2e-local": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/vite-base-ui-e2e"],
      "options": {
        "cwd": "apps/vite-base-ui-e2e",
        "command": "playwright test --config=playwright.config.ts --project=chromium"
      }
    },
    "e2e-visual": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/.playwright/apps/vite-base-ui-e2e"],
      "options": {
        "cwd": "apps/vite-base-ui-e2e",
        "command": "playwright test --config=playwright.config.ts --project=chromium --grep=@visual"
      }
    }
  }
}
