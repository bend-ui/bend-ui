{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["vite/client", "vitest"],
    "paths": {
      "~/*": ["src/*"],
      "@particles/base-ui": ["../../packages/base-ui/src/index.ts"],
      "@particles/react": ["../../packages/react/src/index.ts"],
      "@particles/react-utils": ["../../packages/react-utils/src/index.ts"],
      "@particles/preset": ["../../packages/preset/src/index.ts"],
      "@particles/preset-base": ["../../packages/preset-base/src/index.ts"],
      "@particles/styled-system/*": ["styled-system/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
