{
  "name": "vite-base-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vite-base-ui/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/apps/vite-base-ui"
      ],
      "options": {
        "outDir": "../../dist/apps/vite-base-ui"
      },
      "dependsOn": ["^build", "prepare"]
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/apps/vite-base-ui"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/apps/vite-base-ui"
      },
      "dependsOn": ["^build", "prepare"]
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "vite-base-ui:build",
        "spa": true
      },
      "readyWhen": {
        "signal": true
      }
    },
    "prepare": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/styled-system"],
      "options": {
        "cwd": "apps/vite-base-ui",
        "command": "panda codegen --clean"
      }
    },
    "typecheck": {
      "dependsOn": ["^build", "prepare"]
    }
  }
}
