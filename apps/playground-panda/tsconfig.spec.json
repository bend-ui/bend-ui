{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx"
  },
  "include": [
    "vitest.config.ts",
    "specs/setup.ts",
    "specs/**/*.spec.ts",
    "specs/**/*.spec.tsx",
    "specs/**/*.test.ts",
    "specs/**/*.test.tsx"
  ],
  "exclude": ["node_modules"]
}
