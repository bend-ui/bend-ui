{
  "name": "playground-panda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground-panda",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "serve": {
      "dependsOn": ["prepare"],
      "options": {
        "port": 4202,
        "command": "next dev --webpack"
      },
      "configurations": {
        "production": {
          "command": "pnpm exec nx run playground-panda:start"
        }
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build", "prepare"],
      "outputs": ["{workspaceRoot}/dist/apps/playground-panda/export"],
      "options": {
        "cwd": "apps/playground-panda",
        "command": "next build --webpack",
        "env": {
          "BEND_NEXT_EXPORT": "true"
        }
      }
    },
    "build": {
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/playground-panda/.next",
        "{projectRoot}/.next"
      ],
      "dependsOn": ["^build", "prepare"],
      "options": {
        "command": "next build --webpack"
      }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/styled-system"],
      "options": {
        "cwd": "apps/playground-panda",
        "parallel": false,
        "commands": [
          "panda codegen --clean",
          "panda cssgen --outfile styled-system/styles.css"
        ]
      }
    },
    "test": {
      "dependsOn": ["^build", "prepare"]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/playground-panda",
        "commands": [
          "tsc -p tsconfig.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
