{
  "name": "playground-panda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground-panda",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "serve": {
      "options": {
        "port": 4202
      },
      "configurations": {
        "production": {
          "command": "pnpm exec nx run playground-panda:start"
        }
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/apps/playground-panda/export"],
      "options": {
        "cwd": "apps/playground-panda",
        "command": "next build",
        "env": {
          "BEND_NEXT_EXPORT": "true"
        }
      }
    },
    "build": {
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/playground-panda/.next",
        "{projectRoot}/.next"
      ]
    }
  }
}
