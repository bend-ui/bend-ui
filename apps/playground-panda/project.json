{
  "name": "playground-panda",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground-panda",
  "projectType": "application",
  "tags": ["app"],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/playground-panda"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/playground-panda"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "playground-panda:build",
        "dev": true,
        "port": 4202
      },
      "configurations": {
        "development": {
          "buildTarget": "playground-panda:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "playground-panda:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nx/next:export",
      "options": {
        "buildTarget": "playground-panda:build:production"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/playground-panda/jest.config.ts"
      }
    }
  }
}
