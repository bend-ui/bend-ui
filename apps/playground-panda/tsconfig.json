{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["jest", "node"],
    "paths": {
      "@bend-ui/ark-ui": ["packages/ark-ui/src/index.ts"],
      "@bend-ui/preset": ["packages/preset/src/index.ts"],
      "@bend-ui/preset-base": ["packages/preset-base/src/index.ts"],
      "@bend-ui/primitives": ["packages/primitives/src/index.ts"],
      "@bend-ui/react": ["packages/react/src/index.ts"],
      "@bend-ui/react-utils": ["packages/react-utils/src/index.ts"],
      "@bend-ui/storybook": ["packages/storybook/src/index.ts"],
      "@bend-ui/styled-system/*": ["packages/styled-system/dist/*"],
      "@bend-ui/theme": ["packages/theme/src/index.ts"],
      "@/*": ["apps/playground-panda/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "next-env.d.ts"],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
