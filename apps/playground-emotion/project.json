{
  "name": "playground-emotion",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/playground-emotion",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/playground-emotion",
        "outputPath": "dist/apps/playground-emotion"
      },
      "configurations": {
        "production": {},
        "development": {
          "outputPath": "apps/playground-emotion"
        }
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "playground-emotion:build",
        "dev": true
      },
      "configurations": {
        "production": {
          "buildTarget": "playground-emotion:build:production",
          "dev": false
        },
        "development": {
          "buildTarget": "playground-emotion:build:development",
          "dev": true
        }
      },
      "defaultConfiguration": "development"
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "playground-emotion:build:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/playground-emotion"],
      "options": {
        "jestConfig": "apps/playground-emotion/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/playground-emotion/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": []
}
