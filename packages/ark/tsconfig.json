{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "paths": {
      "~/*": ["src/*"],
      "@particles/preset": ["packages/preset/src/index.ts"],
      "@particles/react": ["packages/react/src/index.ts"],
      "@particles/styled-system/*": ["packages/styled-system/dist/*"],
      "@particles/storybook": ["packages/storybook/src/index.ts"]
    }
  },
  "files": [],
  "include": ["panda.config.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.storybook.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
