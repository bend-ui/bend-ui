{
  "name": "ark",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ark/src",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/ark"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/packages/ark"
      }
    },
    "storybook": {
      "options": {
        "port": 4405,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": [
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/ark"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/ark/.storybook --url=http://localhost:4405"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ark:build-storybook",
        "staticFilePath": "dist/storybook/ark"
      },
      "configurations": {
        "ci": {
          "buildTarget": "ark:build-storybook:ci"
        }
      }
    }
  }
}
