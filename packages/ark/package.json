{
  "name": "@particles/ark",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ark-ui/react": "^5.34.0",
    "@particles/preset": "workspace:*",
    "@particles/react": "workspace:*",
    "@particles/styled-system": "workspace:*"
  },
  "devDependencies": {
    "@particles/storybook": "workspace:*"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "scripts": {
    "prepare": "panda codegen",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  }
}
