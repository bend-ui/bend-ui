{
  "name": "@bend-ui/config",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  },
  "dependencies": {
    "@bend-ui/preset": "workspace:*",
    "@pandacss/dev": "^1.11.4",
    "@pandacss/types": "^1.11.4",
    "tslib": "^2.5.3"
  }
}
