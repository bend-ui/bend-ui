{
  "extends": [
    "plugin:@nx/react",
    "../../.eslintrc.json",
    "plugin:@pandacss/recommended"
  ],
  "ignorePatterns": ["!**/*"],
  "settings": {
    "@pandacss/configPath": "packages/aria/panda.config.ts"
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    }
  ]
}
