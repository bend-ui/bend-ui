{
  "name": "base-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/base-ui/src",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"],
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/base-ui",
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/styled-system"],
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/base-ui"
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/{options.coverage.reportsDirectory}",
        "{workspaceRoot}/coverage/packages/base-ui"
      ],
      "options": {
        "coverage.reportsDirectory": "../../coverage/packages/base-ui"
      }
    },
    "storybook": {
      "options": {
        "port": 4406,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": ["{workspaceRoot}/dist/storybook/@bend-ui/base-ui"],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/@bend-ui/base-ui"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/base-ui/.storybook --url=http://localhost:4406"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "@bend-ui/base-ui:build-storybook",
        "staticFilePath": "dist/storybook/@bend-ui/base-ui",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "@bend-ui/base-ui:build-storybook:ci"
        }
      }
    }
  }
}
