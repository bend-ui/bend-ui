{
  "name": "@bend-ui/base-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.mjs"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.mjs"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.mjs"
    },
    "./recipes/*": {
      "types": "./styled-system/recipes/*.d.ts",
      "default": "./styled-system/recipes/*.mjs"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.mjs"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.mjs"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.mjs"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.mjs"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.mjs"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.mjs"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "styled-system"
  ],
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@bend-ui/core": "workspace:*",
    "@bend-ui/preset": "workspace:*",
    "@bend-ui/styled-system": "workspace:*",
    "lucide-react": "^1.25.0"
  },
  "devDependencies": {
    "@bend-ui/storybook": "workspace:*"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.2.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "scripts": {
    "prepare": "panda codegen",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup && panda codegen && panda lib --files \"./**/*.{js,mjs}\""
  }
}
