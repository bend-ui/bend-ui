{
  "name": "@bend-ui/base-ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@bend-ui/preset": "workspace:*",
    "@bend-ui/react": "workspace:*",
    "@bend-ui/styled-system": "workspace:*",
    "lucide-react": "^1.18.0"
  },
  "devDependencies": {
    "@bend-ui/storybook": "workspace:*"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "scripts": {
    "prepare": "panda codegen",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  }
}
