{
  "name": "react-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react-utils/src",
  "projectType": "library",
  "tags": ["utils"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/react-utils"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverage.reportsDirectory": "../../coverage/packages/react-utils"
      }
    }
  }
}
