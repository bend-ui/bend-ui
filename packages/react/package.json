{
  "name": "@bend-ui/react",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./factory": {
      "source": "./src/factory.ts",
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js",
      "require": "./dist/factory.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bend-ui/core": "workspace:*",
    "@bend-ui/preset": "workspace:*",
    "@bend-ui/primitives": "workspace:*",
    "@bend-ui/styled-system": "workspace:*",
    "@floating-ui/react": "^0.27.20",
    "lucide-react": "^1.25.0"
  },
  "devDependencies": {
    "@bend-ui/storybook": "workspace:*"
  },
  "peerDependencies": {
    "@pandacss/dev": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "scripts": {
    "prepare": "panda codegen",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  }
}
