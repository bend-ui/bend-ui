{
  "name": "@particles/react",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@particles/preset": "workspace:*",
    "@particles/styled-system": "workspace:*"
  },
  "devDependencies": {
    "@particles/storybook": "workspace:*"
  },
  "peerDependencies": {
    "@pandacss/dev": "^0.53.0 || ^0.54.0",
    "react": "^17.0.2 || ^18.2.0",
    "react-dom": "^17.0.2 || ^18.2.0"
  },
  "scripts": {
    "prepare": "panda codegen",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  }
}
