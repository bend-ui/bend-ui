{
  "name": "react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/src",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/react"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/packages/react"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "{projectRoot}/../../coverage/packages/react"
      }
    },
    "storybook": {
      "options": {
        "port": 4402,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": ["{workspaceRoot}/dist/storybook/react"],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/react"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/react/.storybook --url=http://localhost:4402"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "react:build-storybook",
        "staticFilePath": "dist/storybook/react"
      },
      "configurations": {
        "ci": {
          "buildTarget": "react:build-storybook:ci"
        }
      }
    },
    "studio": {
      "command": "panda studio -c packages/react/panda.config.ts"
    }
  }
}
