{
  "name": "@particles/primitives",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  ".": {
    "source": "./src/index.ts",
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@particles/storybook": "workspace:*"
  },
  "scripts": {
    "generate": "pnpm dlx generate-react-cli",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  }
}
