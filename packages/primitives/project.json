{
  "name": "primitives",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/primitives/src",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "build": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/primitives",
        "tsConfig": "packages/primitives/tsconfig.lib.json",
        "project": "packages/primitives/package.json",
        "entryFile": "packages/primitives/src/index.ts",
        "external": ["react/jsx-runtime"],
        "rollupConfig": "@nx/react/plugins/bundle-rollup",
        "assets": [
          {
            "glob": "packages/primitives/README.md",
            "input": ".",
            "output": "."
          }
        ],
        "updateBuildableProjectDepsInPackageJson": true
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/packages/primitives"],
      "options": {
        "jestConfig": "packages/primitives/jest.config.ts"
      }
    },
    "storybook": {
      "options": {
        "port": 4401,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": [
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/primitives"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
