{
  "name": "@bend-ui/preset",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  },
  "dependencies": {
    "@bend-ui/preset-base": "workspace:*",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/types": "^2.2.0",
    "tslib": "^2.5.3"
  }
}
