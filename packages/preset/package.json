{
  "name": "@particles/preset",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "build": "tsup"
  },
  "dependencies": {
    "@pandacss/dev": "^0.46.1",
    "@pandacss/types": "0.45.2",
    "@particles/preset-base": "workspace:*",
    "tslib": "^2.5.3",
    "tsup": "^8.2.4"
  },
  "devDependencies": {
    "tsup": "^8.2.4"
  }
}
