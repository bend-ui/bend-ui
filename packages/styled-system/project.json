{
  "name": "styled-system",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/styled-system/src",
  "projectType": "library",
  "tags": ["preset"],
  "targets": {
    "dev": {
      "command": "panda codegen --watch"
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "panda codegen",
        "cwd": "packages/styled-system"
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs styled-system {args.ver} {args.tag}",
      "dependsOn": ["build"]
    }
  }
}
