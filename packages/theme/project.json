{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/theme",
        "main": "packages/theme/src/index.ts",
        "tsConfig": "packages/theme/tsconfig.lib.json",
        "assets": [
          "packages/theme/*.md"
        ],
        "updateBuildableProjectDepsInPackageJson": true
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "packages/theme/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/packages/theme"
      ],
      "options": {
        "jestConfig": "packages/theme/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": [
    "ui"
  ]
}
