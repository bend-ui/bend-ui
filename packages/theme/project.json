{
  "name": "theme",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "theme/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/theme",
        "main": "packages/theme/src/index.ts",
        "tsConfig": "packages/theme/tsconfig.lib.json",
        "assets": ["packages/theme/*.md"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs theme {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
