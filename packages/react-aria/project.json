{
  "name": "react-aria",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react-aria/src",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup",
        "cwd": "packages/react-aria"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/packages/react-aria"
      }
    },
    "storybook": {
      "options": {
        "port": 4404,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": ["{workspaceRoot}/dist/storybook/react-aria"],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/react-aria"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/react-aria/.storybook --url=http://localhost:4404"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "react-aria:build-storybook",
        "staticFilePath": "dist/storybook/react-aria"
      },
      "configurations": {
        "ci": {
          "buildTarget": "react-aria:build-storybook:ci"
        }
      }
    }
  }
}
