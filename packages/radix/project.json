{
  "name": "radix",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/radix/src",
  "projectType": "library",
  "tags": ["ui"],
  "targets": {
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/packages/radix"
      }
    },
    "storybook": {
      "options": {
        "port": 4403,
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build-storybook": {
      "outputs": [
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/radix"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c packages/radix/.storybook --url=http://localhost:4403"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "radix:build-storybook",
        "staticFilePath": "dist/storybook/radix"
      },
      "configurations": {
        "ci": {
          "buildTarget": "radix:build-storybook:ci"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "panda codegen --watch"
      }
    }
  }
}
