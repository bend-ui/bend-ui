{
  "name": "internal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/internal/src",
  "projectType": "library",
  "tags": ["scope:internal", "type:internal"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
