{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@particles/aria": ["packages/aria/src/index.ts"],
      "@particles/ark": ["packages/ark/src/index.ts"],
      "@particles/cli": ["packages/cli/src/index.ts"],
      "@particles/preset": ["packages/preset/src/index.ts"],
      "@particles/preset-base": ["packages/preset-base/src/index.ts"],
      "@particles/primitives": ["packages/primitives/src/index.ts"],
      "@particles/radix": ["packages/radix/src/index.ts"],
      "@particles/react": ["packages/react/src/index.ts"],
      "@particles/react-utils": ["packages/react-utils/src/index.ts"],
      "@particles/storybook": ["packages/storybook/src/index.ts"],
      "@particles/styled-system/*": ["packages/styled-system/dist/*"],
      "@particles/theme": ["packages/theme/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
