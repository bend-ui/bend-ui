{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bend-ui/aria": ["packages/aria/src/index.ts"],
      "@bend-ui/ariakit": ["packages/ariakit/src/index.ts"],
      "@bend-ui/ark": ["packages/ark/src/index.ts"],
      "@bend-ui/base-ui": ["packages/base-ui/src/index.ts"],
      "@bend-ui/cli": ["packages/cli/src/index.ts"],
      "@bend-ui/preset": ["packages/preset/src/index.ts"],
      "@bend-ui/preset-base": ["packages/preset-base/src/index.ts"],
      "@bend-ui/primitives": ["packages/primitives/src/index.ts"],
      "@bend-ui/radix": ["packages/radix/src/index.ts"],
      "@bend-ui/react": ["packages/react/src/index.ts"],
      "@bend-ui/react-utils": ["packages/react-utils/src/index.ts"],
      "@bend-ui/storybook": ["packages/storybook/src/index.ts"],
      "@bend-ui/styled-system/*": ["packages/styled-system/dist/*"],
      "@bend-ui/theme": ["packages/theme/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
